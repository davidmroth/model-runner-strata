# Optional overrides; every value has a working default in docker-compose.yml.

# Image tag; the upstream commit it is built from is pinned in scripts/prepare-upstream.sh (STRATA_REF).
# After changing them: re-run prepare-upstream.sh, rebuild, then start once with STRATA_REINSTALL=1.
STRATA_VERSION=0.1.38
# 1 = ggml's CPU code for any AVX2 CPU; 0 = tuned to the build machine (the image then only runs on its CPU)
STRATA_PORTABLE=1
# Optional with STRATA_PORTABLE=1: GCC -march name of the serving host's CPU (e.g. raptorlake for 12th-14th gen
# Intel Core) to use its extra instructions such as AVX-VNNI. Empty = plain AVX2 baseline.
STRATA_CPU_ARCH=
# CUDA compute capability: 86 = RTX 30 series, 89 = RTX 40 series ("86;89" for both)
CUDA_ARCHITECTURES=86
# 1 builds the GPU image encoder into the engine; 0 is text only (then set STRATA_VISION=no)
STRATA_BUILD_VISION=1

# Coder IQ1_M: ~32 GB RAM, 58 GB download. 131072 = 128K context (262144 needs 64 GB RAM).
STRATA_FAMILY=coder
STRATA_MODEL=IQ1_M
STRATA_CONTEXT=131072
STRATA_KV=int8
# yes (GPU encoder, keeps ~1.4 GB VRAM free), cpu (10-30 s per picture) or no (text only)
STRATA_VISION=yes
STRATA_GPUS=0,1
GPU_COUNT=2
STRATA_LOW_RAM=off
# Two-GPU split only. 1 = each card keeps its own prompt buffers, so its experts never leave VRAM during a prompt
# (fastest when the cards hold nearly every expert or sit on a slow link such as Thunderbolt); 0 = upstream default
# (borrow cache slots); auto = own buffers only where they cost at most 12% of a card's VRAM.
STRATA_SPLIT_OWN=0
# Two-GPU split only: the first layer on the second card (both families have 48 layers). Empty = upstream's auto split,
# which can give the second card more experts than it holds (check the engine log's expert-cache line after a change).
STRATA_LAYER_SPLIT=
STRATA_DATA_DIR=./models-cache
# What the one-off strata-install service downloads and prepares while the server keeps serving (README: Switching
# models), e.g. qwen / IQ3_XXS. Usually given on the command line instead.
STRATA_INSTALL_FAMILY=
STRATA_INSTALL_MODEL=
# 1 re-runs setup on the next start: needed after changing the model settings above or the upstream commit
STRATA_REINSTALL=0

HF_TOKEN=
# Required on /v1/* when set (Authorization: Bearer ... or x-api-key); saved into the model config at setup
STRATA_API_KEY=
# Without an API key: comma-separated host names clients may use to reach the server besides localhost and IPs
# (e.g. model-runner-strata,strata.lan). Other names get 403. Default: model-runner-strata (the container name).
STRATA_ALLOWED_HOSTS=
