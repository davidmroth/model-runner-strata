# Optional overrides; every value has a working default in docker-compose.yml.
# Upstream's own container settings are documented in docs/DOCKER.md in the Strata repo.

# Image tag: 0.2.9 is the release this repo is set up for. The image is upstream's prebuilt one, so changing
# this needs no build - only a restart. cuda13 needs an NVIDIA driver 580 or newer.
STRATA_VERSION=0.2.9

# qwen family sizes: Q2_0 (~34 GB of experts), IQ2_XS (~35.5 GB), IQ3_XXS (~43 GB). Pick by how much of the
# experts fit in VRAM, not only by RAM - see the README's "Choosing a model".
STRATA_FAMILY=qwen
STRATA_MODEL=Q2_0
STRATA_CONTEXT=131072
STRATA_KV=int8
# off | on | gpu | cpu. gpu keeps about 1.4 GB of VRAM free for the picture reader.
STRATA_VISION=gpu
STRATA_GPUS=0,1
GPU_COUNT=2

# Advanced engine settings, space separated KEY=VALUE, passed to `strata launch --set`.
# STRATA_SPLIT_OWN=1: each card keeps its own prompt buffers instead of borrowing expert-cache slots.
# STRATA_PREFILL_LAYER_MAJOR=0: read a prompt chunk by chunk. Since 0.2.7 a layer split reads it layer by layer
# across both cards, which pays off when experts stream from RAM; on a split where every expert is already in VRAM
# it measured slower (1,992 vs 3,161 tok/s on a 15K-token prompt).
# layer_split=N: the first layer on the second card (both families have 48 layers). Empty = Strata's auto split.
STRATA_SET=STRATA_SPLIT_OWN=1 STRATA_PREFILL_LAYER_MAJOR=0
# quick | thorough | skip. Tuning runs once and takes 20-120 minutes.
STRATA_TUNE=skip
# Requests answered at the same time, 1 to 8. Empty lets Strata fit it to the cards (3 on two). Each slot takes
# about 380 MiB of expert cache, so set 1 when the split is already holding every expert.
STRATA_PARALLEL=

STRATA_DATA_DIR=./models-cache
HF_TOKEN=

# A key is always on for requests that come from outside the container: set one (16+ characters,
# `openssl rand -hex 24`), write `none` to serve without a key on purpose, or leave empty and the first
# start makes one and keeps it in the volume.
STRATA_API_KEY=
# Only matters with no key: comma-separated Host names allowed besides localhost and IP addresses.
STRATA_ALLOWED_HOSTS=model-runner-strata
