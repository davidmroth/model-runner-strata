From 7678896d5a3031e1346c587e5ca7ee8d23564602 Mon Sep 17 00:00:00 2001
From: davidmroth <davidmroth@users.noreply.github.com>
Date: Fri, 2 Oct 2026 04:29:01 +0000
Subject: [PATCH] docker: STRATA_CPU_ARCH build arg to tune the CPU code for
 one host

STRATA_PORTABLE=1 compiles ggml for a plain AVX2 baseline, which leaves out
features a newer CPU has, such as AVX-VNNI on Alder/Raptor Lake. STRATA_CPU_ARCH
passes a GCC -march name (e.g. raptorlake) to both CMake builds so the image is
tuned for that host family without -march=native picking up the build
machine's AVX-512. Empty by default, so existing builds are unchanged.
---
 Dockerfile | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/Dockerfile b/Dockerfile
index 3d57f3c..2fa2f03 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -61,6 +61,9 @@ COPY . .
 ARG CUDA_ARCHITECTURES=75;80;86;89;120
 ARG BUILD_VISION=1
 ARG STRATA_PORTABLE=0
+# Optional GCC -march name (e.g. raptorlake) to tune the CPU code for one host family instead of the AVX2
+# baseline. Use it with STRATA_PORTABLE=1: otherwise ggml's -march=native comes later and wins.
+ARG STRATA_CPU_ARCH=
 
 RUN python3 -m venv .venv \
     && .venv/bin/pip install --no-cache-dir --upgrade pip \
@@ -80,15 +83,18 @@ nvcc, _ = setup.find_nvcc()
 arch = os.environ.get("CUDA_ARCHITECTURES", "75;80;86;89;120").strip().strip('"').replace(",", ";")
 vision = "gpu" if os.environ.get("BUILD_VISION", "1") == "1" else "none"
 portable = [f"-DSTRATA_PORTABLE={'ON' if os.environ.get('STRATA_PORTABLE', '0') == '1' else 'OFF'}"]
+cpu_arch = os.environ.get("STRATA_CPU_ARCH", "").strip()
+cpu_target = [*portable, f"-DCMAKE_C_FLAGS=-march={cpu_arch}", f"-DCMAKE_CXX_FLAGS=-march={cpu_arch}"] \
+    if cpu_arch else portable
 
 setup.cmake_build(setup.ROOT, setup.ROOT / "build", "strata",
     ["-DSTRATA_ENABLE_CUDA=ON", "-DSTRATA_BUILD_TESTS=OFF",
      f"-DCMAKE_CUDA_ARCHITECTURES={arch}", f"-DCMAKE_CUDA_COMPILER={nvcc}",
-     f"-DSTRATA_GGML_DIR={llama}", *portable], None, "build-strata.bat")
+     f"-DSTRATA_GGML_DIR={llama}", *cpu_target], None, "build-strata.bat")
 if vision != "none":
     setup.cmake_build(setup.ROOT / "tools" / "vision", setup.ROOT / "build-vision", "strata-vision",
         [f"-DLLAMA_DIR={llama}", "-DSTRATA_VISION_CUDA=ON",
-         f"-DCMAKE_CUDA_ARCHITECTURES={arch}", f"-DCMAKE_CUDA_COMPILER={nvcc}", *portable], None, "build-vision.bat")
+         f"-DCMAKE_CUDA_ARCHITECTURES={arch}", f"-DCMAKE_CUDA_COMPILER={nvcc}", *cpu_target], None, "build-vision.bat")
 
 eng = setup.ROOT / "engine"
 eng.mkdir(exist_ok=True)
-- 
2.54.0

